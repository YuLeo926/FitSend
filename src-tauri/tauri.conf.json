{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FitSend",
  "version": "0.1.3",
  "identifier": "app.fitsend.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FitSend",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/ffmpeg/*"],
    "shortDescription": "Make files fit their destination, locally.",
    "longDescription": "FitSend creates a verified, upload-ready copy of an image or video without sending the source to a server.",
    "category": "Utility"
  }
}
